{
  "name": "charfloat",
  "version": "2.2.4",
  "description": "Universal Bridge between AI Agents (Doubao, WorkBuddy, Qwen, Kimi, Claude Code, Codex) and Microsoft Office & WPS Office with Audit Trail and GUI",
  "homepage": "https://charfloat.online/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jolly-J/CharFloat.git"
  },
  "main": "dist/main/index.js",
  "bin": {
    "charfloat": "./dist/bridge/cli.cjs",
    "wps-bridge-mcp": "./dist/bridge/cli.cjs"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite",
    "build:renderer": "vite build",
    "build:main": "tsup",
    "build": "npm run build:renderer && npm run build:main && npm run build:bytecode && npm run build:addons",
    "mcp": "tsx src/bridge/cli.ts",
    "setup": "tsx src/bridge/setup.ts",
    "inspect": "tsx scripts/inspect.ts",
    "start": "electron .",
    "dist": "npm run build:release && npm run build:win-icon && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "dev:desktop": "npm run build && electron .",
    "dev:website": "npm --prefix website run dev",
    "build:website": "npm --prefix website run build",
    "check:agents": "node scripts/check-agents.mjs",
    "check:version": "node scripts/check-version.mjs",
    "snapshot:tools": "tsx scripts/snapshot-tools.ts",
    "check:claims": "tsx scripts/check-capability-claims.ts",
    "build:wps-addon": "node scripts/build-wps-addon.mjs",
    "build:office-addon": "node scripts/build-office-addon.mjs",
    "build:addons": "npm run build:wps-addon && npm run build:office-addon",
    "build:win-icon": "node scripts/build-win-icon.mjs",
    "check:params": "tsx scripts/check-param-forwarding.ts",
    "build:bytecode": "node scripts/build-cli-bytecode.mjs",
    "check:protection": "node scripts/check-cli-protection.mjs",
    "dist:all": "npm run build:release && npm run build:win-icon && node scripts/dist-parallel.mjs",
    "dist:mac": "npm run build:release && npm run build:win-icon && electron-builder --mac",
    "dist:win": "npm run build:release && npm run build:win-icon && electron-builder --win",
    "dist:fast": "npm run build:release && npm run build:win-icon && node scripts/dist-parallel.mjs --no-sign",
    "build:release-assets": "node scripts/build-release-assets.mjs",
    "check:release": "node scripts/check-release-protection.mjs",
    "build:release": "npm run build && npm run build:release-assets",
    "check:brand": "node scripts/check-brand.mjs",
    "check:update-secrets": "node scripts/check-update-secrets.mjs",
    "prebuild": "npm run check:version && npm run check:brand && npm run check:update-secrets",
    "postbuild": "node scripts/check-brand.mjs --generated",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "version:set": "node scripts/set-version.mjs",
    "build:update-packages": "node scripts/build-update-packages.mjs",
    "prepare:update": "tsx scripts/prepare-update.ts",
    "check:update-package": "node --import tsx scripts/check-update-package.ts"
  },
  "build": {
    "appId": "com.antigravity.charfloat",
    "productName": "字浮 CharFloat",
    "directories": {
      "output": "release/${version}/${os}"
    },
    "files": [
      {
        "from": "dist/release-app",
        "to": ".",
        "filter": [
          "**/*",
          "!**/.charfloat-local-secrets",
          "!**/.charfloat-local-secrets/**",
          "!package.json"
        ]
      },
      "package.json",
      "!**/.charfloat-local-secrets",
      "!**/.charfloat-local-secrets/**",
      "!**/*-full.cjs",
      "!**/*.map",
      "!**/AGENTS.md"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "字浮 CharFloat 需要访问文稿目录以部署并升级 Excel 加载项清单。",
        "NSDownloadsFolderUsageDescription": "字浮 CharFloat 需要访问下载目录以管理临时配置文件。"
      }
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "asarUnpack": [
      "**/dist/bridge/cli.cjs",
      "**/resources/**/*",
      "**/office-addon/**/*",
      "**/wps-addon/**/*",
      "**/skills/**/*",
      "**/dist/bridge/cli.jsc",
      "**/node_modules/bytenode/**/*",
      "**/dist/bridge/cli-full.cjs"
    ],
    "artifactName": "字浮-CharFloat-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "beforePack": "scripts/before-pack.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "artifactBuildCompleted": "scripts/after-artifact.cjs"
  },
  "keywords": [
    "wps",
    "mcp",
    "ai",
    "excel",
    "cursor",
    "claude"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@xmldom/xmldom": "0.9.12",
    "bytenode": "^1.7.0",
    "clsx": "^2.1.1",
    "jsonc-parser": "3.3.1",
    "lucide-react": "^1.16.0",
    "motion": "^13.4.0",
    "tailwind-merge": "^3.0.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "yaml": "2.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "4.1.1",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "yauzl": "2.10.0"
  }
}
