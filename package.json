{
  "name": "office-agent-bridge",
  "version": "2.1.0",
  "description": "Universal Bridge between AI Agents (Doubao, WorkBuddy, Qwen, Kimi, Claude Code, Codex) and Microsoft Office & WPS Office with Audit Trail and GUI",
  "main": "dist/main/index.js",
  "bin": {
    "office-agent-bridge": "./dist/bridge/cli.cjs",
    "wps-bridge-mcp": "./dist/bridge/cli.cjs"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite",
    "build:renderer": "vite build",
    "build:main": "tsup",
    "build": "npm run build:renderer && npm run build:main && npm run build:addons",
    "mcp": "tsx src/bridge/cli.ts",
    "setup": "tsx src/bridge/setup.ts",
    "inspect": "tsx scripts/inspect.ts",
    "start": "electron .",
    "dist": "npm run build && npm run build:win-icon && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "dev:desktop": "npm run build && electron .",
    "dev:website": "npm --prefix website run dev",
    "build:website": "npm --prefix website run build",
    "check:agents": "node scripts/check-agents.mjs",
    "snapshot:tools": "tsx scripts/snapshot-tools.ts",
    "check:claims": "tsx scripts/check-capability-claims.ts",
    "build:wps-addon": "node scripts/build-wps-addon.mjs",
    "build:office-addon": "node scripts/build-office-addon.mjs",
    "build:addons": "npm run build:wps-addon && npm run build:office-addon",
    "build:win-icon": "node scripts/build-win-icon.mjs",
    "check:params": "tsx scripts/check-param-forwarding.ts"
  },
  "build": {
    "appId": "com.antigravity.officeagentbridge",
    "productName": "Office Agent Bridge",
    "directories": {
      "output": "release/${version}/${os}"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "dist/bridge/cli.cjs",
      "wps-addon/**/*",
      "office-addon/**/*",
      "resources/**/*",
      "skills/**/*",
      "prompts/**/*",
      "package.json",
      "!**/*.map",
      "!**/AGENTS.md",
      "!wps-addon/src/**",
      "!office-addon/src/**"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Office Agent Bridge 需要访问文稿目录以部署并升级 Excel 加载项清单。",
        "NSDownloadsFolderUsageDescription": "Office Agent Bridge 需要访问下载目录以管理临时配置文件。"
      }
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "asarUnpack": [
      "dist/bridge/cli.cjs",
      "resources/**/*",
      "office-addon/**/*",
      "wps-addon/**/*",
      "skills/**/*"
    ],
    "artifactName": "Office-Agent-Bridge-${version}-${os}-${arch}.${ext}"
  },
  "keywords": [
    "wps",
    "mcp",
    "ai",
    "excel",
    "cursor",
    "claude"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@xmldom/xmldom": "0.9.12",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^13.4.0",
    "tailwind-merge": "^3.0.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
