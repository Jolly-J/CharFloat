-          matches.push({
-            address: addr,
-            row: r + 1,
-            col: c + 1,
-            value: val,
-            formula: formStr.startsWith("=") ? formStr : null,
-            matchedIn: hitFormula ? "formula" : "value",
-            replaced: isReplaced
