-          let isReplaced = false;
-
-          if (replaceText !== undefined) {
-            const source = hitFormula ? formStr : cellStr;
-            const newVal = matchEntireCell
-              ? replaceText
-              : source.replace(new RegExp(queryStr.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), matchCase ? 'g' : 'gi'), replaceText);
