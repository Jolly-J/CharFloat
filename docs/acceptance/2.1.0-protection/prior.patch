-      newSheetName: newSheet.Name,
-      positionRequested: pos,
-      positionApplied,
-      actualIndex,
-      totalSheets,
-      warnings,
-      message: `已将工作表 [${sourceSheetName}] 克隆为 [${newSheetName}]（位置 ${positionApplied}，第 ${actualIndex} 位 / 共 ${totalSheets} 张）`
-    };
-  }
