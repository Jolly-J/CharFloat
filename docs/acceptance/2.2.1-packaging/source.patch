-  function saveWorkbook(app, params) {
-    const { workbookName } = params || {};
-    const wb = getWorkbook(app, workbookName);
-    const warnings = [];
-    // 从未保存过的新工作簿（Path 为空）调 Save() 会失败或弹"另存为"——如实告知而非报成功（excel-tester L-4）
