-    // 读回核对：工作簿确实存在、页数、首表名、是否已落盘
-    const g = (fn, d = null) => { try { const x = fn(); return x === undefined ? d : x; } catch (e) { return d; } };
-    const after = Number(app.Workbooks.Count);
