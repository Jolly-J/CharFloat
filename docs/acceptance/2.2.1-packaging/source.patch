-                 "**重启 WPS 后重试**；若仍失败请检查是否有未关闭的模态对话框。"
-      };
-    }
-
-    let saved = null, saveError = null;
-    if (savePath) {
-      // ⚠️ **必须关掉宿主对话框**：目标路径已存在时 `SaveAs` 会弹"是否覆盖"的**模态框**，
-      // 它会阻塞整个 WPS——所有后续调用全部无响应，而且没人点它就一直卡着。
